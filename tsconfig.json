{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "// include": "e2e spec도 타입체크에 포함한다 — 1막에서는 src만 봐서 spec의 오타·미정의 헬퍼가 실행 전까지 드러나지 않았다",
  "include": ["src", "tests"]
}
