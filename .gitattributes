# 셸 스크립트는 어느 OS에서 체크아웃하든 LF로 — CRLF로 받으면 bash가 `\r`을
# 명령 일부로 읽어 `$'\r': command not found`로 죽는다.
*.sh text eol=lf

# 소스·문서는 저장소 안에서 LF로 통일 (작업 디렉터리는 각자 설정을 따른다)
*.ts text
*.mjs text
*.json text
*.md text
*.css text
*.html text
*.svg text
*.pix text

# 바이너리 — 절대 변환하지 않는다
*.png binary
*.jpg binary
*.ico binary
